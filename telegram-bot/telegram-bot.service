[Unit]
Description=Ludo Master 3D Telegram bot
After=network.target

[Service]
Type=simple
User=ludo
Group=ludo
WorkingDirectory=/opt/ludo/telegram-bot
EnvironmentFile=/opt/ludo/telegram-bot/.env
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
